# Exclude everything that doesn't need to be inside the Docker build context.
# This keeps builds fast and prevents accidental inclusion of secrets.

# Version control
.git
.gitignore

# Dependencies (re-installed inside the image)
node_modules

# Next.js build output (rebuilt inside the image)
.next
out

# Local environment files – never ship secrets into an image
.env*

# Editor / OS noise
.DS_Store
*.pem

# Test reports
playwright-report
test-results
coverage

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts
README.md
